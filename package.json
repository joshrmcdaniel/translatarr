{
  "name": "translatarr",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run swagger:ui && next dev",
    "build": "bun run swagger:ui && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:mcp": "bun build tests/mcp/tools.test.ts --target=node --packages=external --outfile=data/tests/mcp.test.mjs && node data/tests/mcp.test.mjs",
    "eval:translations": "bun build scripts/eval-translations.ts --target=node --packages=external --outfile=data/eval-translations.mjs && node data/eval-translations.mjs",
    "swagger:ui": "bun scripts/copy-swagger-ui.mjs",
    "openapi:dump": "bun scripts/dump-openapi.ts",
    "clients:regen:python": "clients/python/scripts/regenerate.sh",
    "clients:regen:ts": "clients/typescript/scripts/regenerate.sh",
    "clients:regen:rust": "clients/rust/scripts/regenerate.sh",
    "clients:regen": "bun run clients:regen:python && bun run clients:regen:ts && bun run clients:regen:rust"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.1.1",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "swagger-ui-dist": "5.34.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "^2.1.3"
  }
}
